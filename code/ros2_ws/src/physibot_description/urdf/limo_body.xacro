<?xml version="1.0"?>
<!-- Shared Limo-class links/joints (no outer <robot>). Included by physibot_*.urdf.xacro -->
<xacro:property name="body_length" value="0.322"/>
  <xacro:property name="body_width" value="0.220"/>
  <xacro:property name="body_height" value="0.180"/>
  <xacro:property name="wheelbase" value="0.200"/>
  <xacro:property name="tread" value="0.175"/>
  <xacro:property name="wheel_radius" value="0.040"/>
  <xacro:property name="wheel_width" value="0.030"/>
  <xacro:property name="ground_clearance" value="0.024"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="physibot_blue">
        <color rgba="0.15 0.35 0.65 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.8"/>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.07"/>
    </inertial>
  </link>

  <!-- Simplified four-wheel differential layout (teaching stub). -->
  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <material name="wheel_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      </collision>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="fl" x="${wheelbase/2}" y="${tread/2}"/>
  <xacro:wheel prefix="fr" x="${wheelbase/2}" y="${-tread/2}"/>
  <xacro:wheel prefix="rl" x="${-wheelbase/2}" y="${tread/2}"/>
  <xacro:wheel prefix="rr" x="${-wheelbase/2}" y="${-tread/2}"/>

  <!-- EAI T-mini Pro–class mount (pose approximate for teaching). -->
  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="lidar_grey">
        <color rgba="0.4 0.4 0.45 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.05 0 ${body_height + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- Depth camera mount (Orbbec DaBai–class pose approximate). -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.04 0.08 0.03"/>
      </geometry>
      <material name="cam_dark">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${body_length/2 - 0.02} 0 ${body_height * 0.7}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
  </joint>
